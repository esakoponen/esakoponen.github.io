---
import Container from "@/components/tui/commons/container.astro";
import Content from "@/components/tui/commons/content.astro";
import Label from "@/components/tui/commons/label.astro";

export interface Props {
  title?: string;
  usage: {
    label: string;
    /** la primera herramienta es la favorita; `share` = % del tiempo, suman 100 */
    tools: { name: string; share: number }[];
  }[];
}

const { title = "CPU [daily usage]", usage } = Astro.props;
const CELLS = 10;

/** reparte las 10 celdas redondeando sobre el acumulado, así siempre suman 10 */
function toCells(tools: { share: number }[]): number[] {
  let acc = 0;
  return tools.map(({ share }) => {
    const from = Math.round((acc / 100) * CELLS);
    acc += share;
    return Math.round((Math.min(acc, 100) / 100) * CELLS) - from;
  });
}

const color = (i: number) => (i === 0 ? "text-accent" : "text-complement");
---

<Container>
  <Label>{title}</Label>
  <Content>
    <ul class="font-mono flex flex-col gap-y-1">
      {usage.map(({ label, tools }) => {
        const cells = toCells(tools);
        const empty = CELLS - cells.reduce((a, b) => a + b, 0);
        return (
          <li class="flex items-center gap-3">
            <span class="w-[9ch] shrink-0">{label}</span>
            <span class="shrink-0 whitespace-pre" aria-hidden="true">
              {cells.map((n, i) => (
                <span class={color(i)}>{"■".repeat(n)}</span>
              ))}
              {empty > 0 && <span class="text-dim">{"□".repeat(empty)}</span>}
            </span>
            <span class="min-w-0 truncate">
              {tools.map(({ name }, i) => (
                <>
                  {i > 0 && <span class="text-dim"> / </span>}
                  <span class={color(i)}>{name}</span>
                </>
              ))}
            </span>
          </li>
        );
      })}
    </ul>
  </Content>
</Container>
