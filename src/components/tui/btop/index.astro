---
import Prompt from "@/components/tui/commons/prompt.astro";
import config from "@/config.json";
import Afk from "./afk.astro";
import Cpu from "./cpu.astro";
import Memory from "./memory.astro";

const uses = config.sections.uses;
---

<Prompt cmd={uses.command} class="mb-5" />
<div class="my-2 flex flex-col gap-5">
  <Cpu title={uses.cpu.label} usage={uses.cpu.usage} />
  <Memory title={uses.memory.label} usage={uses.memory.usage} />
  <Afk afk={uses.afk} />
</div>
