---
import Container from "@/components/tui/commons/container.astro";
import Content from "@/components/tui/commons/content.astro";
import Label from "@/components/tui/commons/label.astro";

export interface Props {
  projects: {
    name: string;
    description: string;
    stack: string[];
    url: string;
    homepage?: string;
  }[];
}

const { projects } = Astro.props;
---

{projects.map((project, i) => (
  <div data-detail={i} hidden={i !== 0} class="h-full">
    <Container>
      <Label>{project.name}</Label>
      <Content>
        <div class="mb-2">{project.description}</div>
        <div>
          {project.stack.length > 0 && (
            <span class="text-dim">{project.stack.join(" + ")} </span>
          )}
          <a
            class="text-accent hover:underline"
            href={project.url}
            target="_blank"
            rel="noopener"
            >{"-> repo"}</a
          >
        </div>
        {project.homepage && (
          <a
            class="text-accent hover:underline"
            href={project.homepage}
            target="_blank"
            rel="noopener"
            >{"-> visit site"}</a
          >
        )}
      </Content>
    </Container>
  </div>
))}
