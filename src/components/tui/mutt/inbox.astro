---
export interface Mail {
  selected?: boolean;
  from: string;
  date?: string;
  href?: string;
}

export interface Props {
  mails: Mail[];
}

const { mails } = Astro.props;
---

<div class="font-mono my-2">
  {mails.map(({ from, date, href }) => {
    const Tag = href ? "a" : "div";
    return (
      <Tag
        class="grid grid-cols-12 gap-x-4 group"
        href={href}
        target={href && !href.startsWith("mailto:") ? "_blank" : undefined}
        rel={href && !href.startsWith("mailto:") ? "noopener" : undefined}
      >
        <span class={`col-span-3 text-c2 ${href ? "hover:cursor-pointer group-hover:text-accent" : ""}`}>
          {from}
        </span>
        {date && (
          <span class="col-span-9 flex justify-end text-dim">
            {date}
          </span>
        )}
      </Tag>
    );
  })}
</div>
